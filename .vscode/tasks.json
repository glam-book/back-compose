{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "database",
            "type": "shell",
            "command": "${workspaceRoot}/deploy-db.sh",
        },
        {
            "label": "liquibase",
            "type": "shell",
            "command": "${workspaceRoot}/gradlew",
            "args": ["update"]
        },
        {
            "label": "clean-start",
            "dependsOrder": "sequence",
            "dependsOn": ["database", "liquibase"]
        }
    ]
}